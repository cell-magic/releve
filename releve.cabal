cabal-version:      2.4
name:               releve
version:            0.9.1
synopsis:           Judge observed web pages; keep every reading.
description:
  The judging half of relevé. Reads observations of rendered web pages,
  keeps them in an append-only sealed corpus, and derives from it a
  checkable report (facts) and a study dataset (atlas).
category:           Web, Accessibility
license:            EUPL-1.2
license-file:       LICENSE
author:             Anna Teterkina
maintainer:         anna@bureaudessurfaces.fr
build-type:         Simple
extra-doc-files:    README.md

executable releve
  main-is:          Main.hs
  hs-source-dirs:   kernel/app, kernel/src
  other-modules:    Stamp, Releve.Types, Releve.Colour, Releve.Footprint, Releve.Criteria,
                    Releve.Corpus, Releve.Kernel, Releve.Reading, Releve.Report, Releve.Views, Releve.Declarations, Releve.Checklist, Releve.Frameworks, Releve.Statement
  build-depends:    base >=4.14 && <5, aeson >=2.0 && <2.3, bytestring >=0.10 && <0.13,
                    containers >=0.6 && <0.8, text >=1.2 && <2.2, directory >=1.3 && <1.4,
                    cryptohash-sha256 >=0.11 && <0.12, process >=1.6 && <1.7, filepath >=1.4 && <1.6
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing
