-- What changed on a page from one record of it to a later one, as typed differences:
-- each a key and a signed count, +n where there is more, -n where there is less. The
-- Bureau keeps no record, so a change is never stored: it is derived, whenever wanted,
-- from two records the member holds. Records of two different pages are not compared.
--
-- Changes are a Z-set in its one form: ascending by kind, then key; each key once; no zero.
-- So they add: changes a b, added to changes b c, are changes a c; changes b a are changes
-- a b negated; changes a a are none (tests/record.py holds the three).
module Changes where

import Json

-- A rule's mark counts on a record, by criterion and machine label.
marks : Text -> Text -> List Json -> Int
marks criterion label rules =
  foldl (\n r -> if asText (field "criterion" r) == criterion then n + asInt (field label r) else n) 0 rules

criteriaOf : List Json -> List Text
criteriaOf rules = map (\r -> asText (field "criterion" r)) rules

union : List Text -> List Text -> List Text
union xs ys = xs ++ filter (\y -> not (elem y xs)) ys

change : Text -> Text -> Int -> Json
change kind key delta = object [entry "kind" (JText kind), entry "key" (JText key), entry "delta" (JInt delta)]

-- The rules: for each criterion and label whose count moved, by how much.
ruleChanges : List Json -> List Json -> List Json
ruleChanges before after =
  concat (map (\c -> concat (map (\l -> let d = marks c l after - marks c l before in
                                        if d == 0 then [] else [change l c d])
                                 ["fail", "review", "hint"]))
              (union (criteriaOf after) (criteriaOf before)))

readingValue : Text -> Json -> Json
readingValue name r = foldl (\v x -> if asText (field "name" x) == name then field "value" x else v) JNull (asList (field "readings" r))

thirdParties : Json -> List Text
thirdParties r = map (\d -> asText (field "domain" d))
  (filter (\d -> asText (field "party" d) == "third") (asList (field "domains" (readingValue "dependencies" r))))

-- Third parties: +1 for each that appeared, -1 for each that left.
domainChanges : Json -> Json -> List Json
domainChanges before after =
  let b = thirdParties before in
  let a = thirdParties after in
  map (\d -> change "third-party" d 1) (filter (\d -> not (elem d b)) a)
  ++ map (\d -> change "third-party" d (0 - 1)) (filter (\d -> not (elem d a)) b)

-- A count of an earlier and a later record, if it moved.
moved : Text -> Int -> Int -> List Json
moved key before after = if after == before then [] else [change "measure" key (after - before)]

measureChanges : Json -> Json -> List Json
measureChanges before after =
  moved "bytes" (asInt (path ["observation", "bytes", "total"] before)) (asInt (path ["observation", "bytes", "total"] after))
  ++ moved "requests" (length (asList (path ["observation", "requests"] before))) (length (asList (path ["observation", "requests"] after)))
  ++ moved "before-interaction" (early before) (early after)
  ++ moved "obstacles" (asInt (field "obstacles" (readingValue "legibility" before))) (asInt (field "obstacles" (readingValue "legibility" after)))

early : Json -> Int
early r = length (filter (\q -> asBool (field "pre_interaction" q)) (asList (path ["observation", "requests"] r)))

-- The one form of a list of changes: ascending by kind and key, each key once with its
-- deltas summed, and none whose sum is zero.
consolidate : List Json -> List Json
consolidate cs =
  let sorted = sortBy (\x y -> kindOf x < kindOf y || (kindOf x == kindOf y && keyOf x < keyOf y)) cs in
  reverse (filter (\c -> asInt (field "delta" c) /= 0) (foldl merged [] sorted))

kindOf : Json -> Text
kindOf c = asText (field "kind" c)

keyOf : Json -> Text
keyOf c = asText (field "key" c)

merged : List Json -> Json -> List Json
merged acc c = case acc of
  | [] -> [c]
  | top :: rest -> if kindOf top == kindOf c && keyOf top == keyOf c
                   then change (kindOf c) (keyOf c) (asInt (field "delta" top) + asInt (field "delta" c)) :: rest
                   else c :: acc

-- {"changes": [[change]]} gives {"changes": [change]}: their sum, in the one form.
changesAdd : Json -> Json
changesAdd input = object [ entry "changes" (JList (consolidate (concat (map asList (asList (field "changes" input)))))) ]

-- {"before": record, "after": record} gives {"page", "from", "to", "compared", "changes": [{kind, key, delta}]}.
changesOf : Json -> Json
changesOf input =
  let b = field "before" input in
  let a = field "after" input in
  let same = asText (field "url" b) == asText (field "url" a) && asText (field "site" b) == asText (field "site" a) in
  object [ entry "page" (field "url" a), entry "from" (field "cycle" b), entry "to" (field "cycle" a)
         , entry "compared" (JBool same)
         , entry "changes" (JList (if same then consolidate (ruleChanges (asList (field "rules" b)) (asList (field "rules" a))
                                                             ++ domainChanges b a ++ measureChanges b a) else [])) ]
