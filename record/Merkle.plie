-- The month's tree (RFC 6962): a leaf is SHA-256(0x00 || data), a node SHA-256(0x01 || left
-- || right), the empty tree SHA-256 of nothing. Leaves are the records' hashes, in ascending
-- order. The tree is built level by level, adjacent nodes paired and an odd last node carried
-- up as it is: the same tree as RFC 6962's split at the largest power of two (checked for
-- every size up to 2048; HANDOVER.md, question 2), with every recursion on structure.
module Merkle where

import Json

leafHash : Bytes -> Bytes
leafHash d = sha256 (byte 0 ++ d)

nodeHash : Bytes -> Bytes -> Bytes
nodeHash l r = sha256 (byte 1 ++ l ++ r)

-- One level up: adjacent nodes paired, an odd last one carried.
pairUp : List Bytes -> List Bytes
pairUp xs = case xs of
  | a :: b :: rest -> nodeHash a b :: pairUp rest
  | _ -> xs

-- Up to the root. `fuel` is any list at least as long as the number of levels; the leaves
-- themselves serve, and recursion runs on it, so the climb ends by structure.
climb : List Bytes -> List Bytes -> Bytes
climb fuel level = case level of
  | [] -> sha256 (utf8 "")
  | h :: more -> case more of
    | [] -> h
    | _ -> case fuel of
      | [] -> h
      | f :: rest -> climb rest (pairUp level)

-- The leaves in the tree's order: the data sorted, ascending by byte.
ordered : List Bytes -> List Bytes
ordered ds = sortBy (\a b -> a < b) ds

root : List Bytes -> Bytes
root ds = let ls = map leafHash (ordered ds) in climb ls ls

-- A step of an inclusion path: the sibling, and on which side it stands.
data Step = OnLeft Bytes | OnRight Bytes

-- The path from the leaf at position i up to the root, as `climb` builds it.
pathAt : List Bytes -> Int -> List Bytes -> List Step
pathAt fuel i level = case fuel of
  | [] -> []
  | f :: rest -> if length level < 2 then [] else
      let sibling = if mod i 2 == 0 then mapMaybe OnRight (nth (i + 1) level) else mapMaybe OnLeft (nth (i - 1) level) in
      sibling ++ pathAt rest (div i 2) (pairUp level)

mapMaybe : (Bytes -> Step) -> Maybe Bytes -> List Step
mapMaybe f m = case m of
  | Just x -> [f x]
  | Nothing -> []

-- Where a datum stands among the leaves, if it does.
position : Bytes -> List Bytes -> Int
position d ds = length (filter (\x -> x < d) (ordered ds))

pathOf : Bytes -> List Bytes -> List Step
pathOf d ds = let ls = map leafHash (ordered ds) in pathAt ls (position d ds) ls

-- The root a path leads to from a datum. Completeness: for every datum among the leaves,
-- rootFrom d (pathOf d ds) == root ds, whatever function sha256 is (to be proved in Lean).
rootFrom : Bytes -> List Step -> Bytes
rootFrom d steps = foldl (\acc s -> up acc s) (leafHash d) steps

up : Bytes -> Step -> Bytes
up acc s = case s of
  | OnLeft x -> nodeHash x acc
  | OnRight x -> nodeHash acc x

-- A path as JSON: each step {"left": hex} or {"right": hex}.
stepJson : Step -> Json
stepJson s = case s of
  | OnLeft x -> object [entry "left" (JText (hex x))]
  | OnRight x -> object [entry "right" (JText (hex x))]

stepOf : Json -> Maybe Step
stepOf j = if has "left" j then mapStep OnLeft (unhex (asText (field "left" j)))
  else if has "right" j then mapStep OnRight (unhex (asText (field "right" j))) else Nothing

mapStep : (Bytes -> Step) -> Maybe Bytes -> Maybe Step
mapStep f m = case m of
  | Just x -> if bytesLength x == 32 then Just (f x) else Nothing
  | Nothing -> Nothing

-- The month's batch: {"leaves": [hex]} gives {"root": hex, "size": n, "paths": {hex: [step]}}.
merkleBatch : Json -> Json
merkleBatch input =
  let ds = hexes (asList (field "leaves" input)) in
  object [ entry "root" (JText (hex (root ds))), entry "size" (JInt (length ds))
         , entry "paths" (object (map (\d -> entry (hex d) (JList (map stepJson (pathOf d ds)))) (ordered ds))) ]

hexes : List Json -> List Bytes
hexes js = concat (map (\j -> maybeList (unhex (asText j))) js)

maybeList : Maybe Bytes -> List Bytes
maybeList m = case m of
  | Just x -> [x]
  | Nothing -> []
