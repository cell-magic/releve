-- The order the selector reads a site's candidate pages in, drawn from a public beacon.
-- seed = SHA-256(randomness || site || cycle); each candidate is placed by SHA-256(seed || its
-- address), ascending. The selector (receipt/, surface-core/select-1) starts from the first
-- page of that order and breaks its ties by it, so neither the Bureau nor the site chooses
-- where the selection begins. The candidates are committed to, and the commitment dated,
-- before the round is drawn (record/run.py): `commitment` is what is dated.
--
-- A Seed is sealed: only seedOf makes one, from a round's randomness, its site and cycle,
-- and only orderBy uses one. No other code can make an order from bytes of its choosing:
-- that the round chose, not the Bureau, holds by the language, before any check does.
module Seed where

import Json

sealed data Seed = Seed Bytes

seedOf : Bytes -> Text -> Text -> Seed
seedOf randomness site cycle = Seed (sha256 (randomness ++ utf8 site ++ utf8 cycle))

seedHex : Seed -> Text
seedHex s = case s of
  | Seed b -> hex b

placeOf : Seed -> Text -> Bytes
placeOf s url = case s of
  | Seed b -> sha256 (b ++ utf8 url)

orderBy : Seed -> List Text -> List Text
orderBy seed urls = sortBy (\a b -> placeOf seed a < placeOf seed b) urls

-- The candidates as committed to: sorted by code point, each once, as canonical JSON text.
commitment : List Text -> Text
commitment urls = digest (texts (dedupe (sortBy (\a b -> a < b) urls)))

dedupe : List Text -> List Text
dedupe xs = reverse (foldl (\acc x -> if nth 0 acc == Just x then acc else x :: acc) [] xs)

-- {"randomness": hex, "site", "cycle", "candidates": [url]} gives {"seed": hex, "order": [url], "commitment": hex}.
orderOf : Json -> Json
orderOf input =
  let r = fromMaybe (utf8 "") (unhex (asText (field "randomness" input))) in
  let urls = map asText (asList (field "candidates" input)) in
  let seed = seedOf r (asText (field "site" input)) (asText (field "cycle" input)) in
  object [ entry "seed" (JText (seedHex seed)), entry "order" (texts (orderBy seed urls))
         , entry "commitment" (JText (commitment urls)) ]

-- {"candidates": [url]} gives {"commitment": hex, "candidates": [url]}: what is dated before the round.
commitmentOf : Json -> Json
commitmentOf input =
  let urls = map asText (asList (field "candidates" input)) in
  object [ entry "commitment" (JText (commitment urls)), entry "candidates" (texts (dedupe (sortBy (\a b -> a < b) urls))) ]

-- The first round drand publishes strictly after a time: the round a commitment dated then must take.
firstRoundAfter : Int -> Int
firstRoundAfter t = div (t - 1692803367) 3 + 2
